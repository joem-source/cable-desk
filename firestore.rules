rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed in with a verified @gothamsound.com Google account
    function staff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@gothamsound[.]com$');
    }
    // Orders entered or amended in the Cable Desk. No deletes; cancel instead.
    match /orders/{orderId} {
      allow read, create, update: if staff();
    }
    // FormDocs history (written once by import.html)
    match /history_chunks/{chunkId} {
      allow read, write: if staff();
    }
    match /meta/{docId} {
      allow read, write: if staff();
    }
  }
}
